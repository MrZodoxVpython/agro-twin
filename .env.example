# Environment AgroTwin — salin ke .env dan isi dengan nilai milik Anda.
# Berkas .env tidak boleh di-commit (sudah tercantum di .gitignore).
# Jangan pernah masukkan password/database produksi ke dalam source code.

# Koneksi database Neon PostgreSQL yang digunakan aplikasi saat runtime (Vercel).
# Gunakan connection string pooled Neon dengan SSL/TLS, contoh format:
# postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=

# Koneksi langsung (non-pooler) Neon, hanya untuk menjalankan migrasi Prisma.
# postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require
DIRECT_DATABASE_URL=

# Kunci rahasia untuk JWT. Hasilkan string acak, contoh:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# Opsional: URL layanan analitik eksternal untuk prediksi (kosongkan untuk pakai regresi bawaan)
ANALYTICS_URL=